# Public host names
DOMAIN=example.com
APP_ORIGIN=https://example.com

# PostgreSQL container and application connection
POSTGRES_DB=aeromark
POSTGRES_USER=aeromark
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL
DATABASE_POOL_MAX=12

# Owner-only API access
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL

# Internal API settings
PORT=4000
DATABASE_SSL=disable
DATABASE_SSL_INSECURE=0
