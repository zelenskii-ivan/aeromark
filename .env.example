# Скопируйте в .env и заполните. Файл .env никогда не коммитится.
# Секреты генерируйте так: openssl rand -base64 32

# Домен сайта без схемы, для Caddy и выпуска TLS-сертификата
DOMAIN=aeromark.example.com
# Полный HTTPS-адрес сайта: используется в CORS API
APP_ORIGIN=https://aeromark.example.com

# Подтверждение почты через Resend
RESEND_API_KEY=
EMAIL_FROM="Аэромарк <noreply@aeromark.example.com>"

POSTGRES_DB=aeromark
POSTGRES_USER=aeromark
POSTGRES_PASSWORD=

# Хост postgres — имя сервиса из docker-compose
DATABASE_URL=postgres://aeromark:ЗАМЕНИТЕ@postgres:5432/aeromark
# require — для управляемой базы с TLS; пусто — для базы в приватной сети compose
DATABASE_SSL=

# Токен для административной блокировки семей и служебных приглашений
ADMIN_BOOTSTRAP_TOKEN=
