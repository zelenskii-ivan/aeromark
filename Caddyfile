{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Cross-Origin-Opener-Policy "same-origin"
    # Приложение не грузит внешние скрипты и шрифты; unsafe-inline нужен Next
    # для инлайн-стилей и гидрации, connect-src — для собственного API.
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
    -Server
  }

  # Service worker обязан обновляться сразу, иначе новый деплой не доедет.
  @sw path /sw.js
  header @sw Cache-Control "no-cache, no-store, must-revalidate"

  @static path /_next/static/* /icon-*.png /flight-map.webp
  header @static Cache-Control "public, max-age=31536000, immutable"

  @api path /api/* /health
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }
}
